text 55 72 N1
text 178 65 N2
text 283 65 N3
text 388 65 N4
text 428 72 N5
text 428 290 N6
# Apoyos empotrados
color #555
lw 1.5
line 60 280 100 280
line 60 280 60 300
line 65 300 60 280
line 70 300 65 280
line 75 300 70 280
line 80 300 75 280
line 85 300 80 280
line 90 300 85 280
line 95 300 90 280
