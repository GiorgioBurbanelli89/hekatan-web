## 2. Datos del Problema (MATLAB script)

> GIVEN VALUES
@{columns 2}
E = 30e6
> Modulus of elasticity (psi)
G = 12e6
> Modulus of rigidity (psi)
@{end columns}

> Members 1 & 3
@{columns 2}
A1 = 50
> Cross-sectional area A (in^2)
Iz1 = 200
> Second Moment of Inertia in z axes (in^4)
Iy1 = 200
> Second Moment of Inertia in y axes (in^4)
J1 = 40
> Torsional constant (in^4)
m_bar1 = 0.2
> Distributed mass (lb-s^2/in^2)
I0_1 = 205
> Polar moment of inertia (in^4)
@{end columns}

> Members 2 & 4
@{columns 2}
A2 = 28
> Cross-sectional area A (in^2)
Iz2 = 64
> Second Moment of Inertia in z axes (in^4)
Iy2 = 64
> Second Moment of Inertia in y axes (in^4)
J2 = 12.8
> Torsional constant (in^4)
m_bar2 = 0.1
> Distribution mass (lb-s^2/in^2)
I0_2 = 68
> Polar moment of inertia (in^4)
@{end columns}

---
## 3. Modelo (nodos y conectividad)

> Coordenadas de nodos (in)

nodes = [0, 0, 0;
  0, 200, 0;
  -200, 0, 0;
  0, 0, -200;
  200, 0, 0]
@{columns 2}
nNod = 5
> Total nodes
nDof_nod = 6
> DOFs per node
@{end columns}

dof = nNod*nDof_nod

> Conectividad: conn = [1,2,3; 1,3,2; 1,4,2; 1,5,2]
> Elemento 1: nodos 1->2, aux=3 (Member type 1)
> Elemento 2: nodos 1->3, aux=2 (Member type 2)
> Elemento 3: nodos 1->4, aux=2 (Member type 1)
> Elemento 4: nodos 1->5, aux=2 (Member type 2)

@{awatif 700 500}
camera 400 300 400

# Nodos (0-indexed)
node 0 0 0
node 0 200 0
node -200 0 0
node 0 0 -200
node 200 0 0

# Elementos tipo frame
element frame 0 1 E:$E A:$A1 Iz:$Iz1 Iy:$Iy1 J:$J1 G:$G
element frame 0 2 E:$E A:$A2 Iz:$Iz2 Iy:$Iy2 J:$J2 G:$G
element frame 0 3 E:$E A:$A1 Iz:$Iz1 Iy:$Iy1 J:$J1 G:$G
element frame 0 4 E:$E A:$A2 Iz:$Iz2 Iy:$Iy2 J:$J2 G:$G

# Apoyos fijos en nodos 1-4
support 1 fixed
support 2 fixed
support 3 fixed
support 4 fixed

# Carga en nodo 0, direccion Z
load 0 fz:5000

# Resolver
solve static
@{end awatif}

---
## 4. Ensamblaje K y M Global

K = zeros(dof, dof)
M = zeros(dof, dof)

> Elemento 1: nodos 1->2, miembros 1&3 (A1, Iz1, ...)
coord1 = [0, 0, 0;
  0, 200, 0;
  -200, 0, 0]
ke1 = SpaceFrameElement(E, G, Iz1, Iy1, J1, A1, coord1)
me1 = SpaceFrameConsMass(m_bar1, I0_1, A1, coord1)

> Ensamblar elem 1 (DOFs 1-6 y 7-12)
for i = 1:12
  for j = 1:12
    K[i,j] = K[i,j] + ke1[i,j]
    M[i,j] = M[i,j] + me1[i,j]
  end
end

> Elemento 2: nodos 1->3 (Member type 2)
coord2 = [0, 0, 0;
  -200, 0, 0;
  0, 200, 0]
ke2 = SpaceFrameElement(E, G, Iz2, Iy2, J2, A2, coord2)
me2 = SpaceFrameConsMass(m_bar2, I0_2, A2, coord2)

> Ensamblar elem 2 (DOFs 1-6 y 13-18)
for i = 1:6
  for j = 1:6
    K[i,j] = K[i,j] + ke2[i,j]
    M[i,j] = M[i,j] + me2[i,j]
    K[i,j+12] = K[i,j+12] + ke2[i,j+6]
    M[i,j+12] = M[i,j+12] + me2[i,j+6]
    K[i+12,j] = K[i+12,j] + ke2[i+6,j]
    M[i+12,j] = M[i+12,j] + me2[i+6,j]
    K[i+12,j+12] = K[i+12,j+12] + ke2[i+6,j+6]
    M[i+12,j+12] = M[i+12,j+12] + me2[i+6,j+6]
  end
end

> Elemento 3: nodos 1->4 (Member type 1)
coord3 = [0, 0, 0;
  0, 0, -200;
  0, 200, 0]
ke3 = SpaceFrameElement(E, G, Iz1, Iy1, J1, A1, coord3)
me3 = SpaceFrameConsMass(m_bar1, I0_1, A1, coord3)

> Ensamblar elem 3 (DOFs 1-6 y 19-24)
for i = 1:6
  for j = 1:6
    K[i,j] = K[i,j] + ke3[i,j]
    M[i,j] = M[i,j] + me3[i,j]
    K[i,j+18] = K[i,j+18] + ke3[i,j+6]
    M[i,j+18] = M[i,j+18] + me3[i,j+6]
    K[i+18,j] = K[i+18,j] + ke3[i+6,j]
    M[i+18,j] = M[i+18,j] + me3[i+6,j]
    K[i+18,j+18] = K[i+18,j+18] + ke3[i+6,j+6]
    M[i+18,j+18] = M[i+18,j+18] + me3[i+6,j+6]
  end
end

> Elemento 4: nodos 1->5 (Member type 2)
coord4 = [0, 0, 0;
  200, 0, 0;
  0, 200, 0]
ke4 = SpaceFrameElement(E, G, Iz2, Iy2, J2, A2, coord4)
me4 = SpaceFrameConsMass(m_bar2, I0_2, A2, coord4)

> Ensamblar elem 4 (DOFs 1-6 y 25-30)
for i = 1:6
  for j = 1:6
    K[i,j] = K[i,j] + ke4[i,j]
    M[i,j] = M[i,j] + me4[i,j]
    K[i,j+24] = K[i,j+24] + ke4[i,j+6]
    M[i,j+24] = M[i,j+24] + me4[i,j+6]
    K[i+24,j] = K[i+24,j] + ke4[i+6,j]
    M[i+24,j] = M[i+24,j] + me4[i+6,j]
    K[i+24,j+24] = K[i+24,j+24] + ke4[i+6,j+6]
    M[i+24,j+24] = M[i+24,j+24] + me4[i+6,j+6]
  end
end

---
## 5. Condiciones de Contorno

> Nodos 2,3,4,5 fijos (DOFs 7:30)
> Nodo 1 libre (DOFs 1:6)

> Extraer submatrices libres (6x6)
Kf = zeros(6,6)
Mf = zeros(6,6)
for i = 1:6
  for j = 1:6
    Kf[i,j] = K[i,j]
    Mf[i,j] = M[i,j]
  end
end

> Carga: F(3) = 5000 (direccion Z en nodo 1)
Ff = [0;
  0;
  5000;
  0;
  0;
  0]

---
## 6. Solucion Estatica

Uf = lsolve(Kf, Ff)
> Desplazamientos del nodo 1:
Uf

---
## 7. Eigenvalores y Frecuencias Naturales

> Resolver K*phi = omega^2 * M * phi
w2 = eigenvalues(Kf, Mf)

> Frecuencias naturales (vectores)
pi_val = 3.14159265358979
omega = sqrt(w2)
f = omega/(2*pi_val)
T = dotDivide(1, f)

> Extraer componentes para resultados
omega1 = omega.(1); omega2 = omega.(2); omega3 = omega.(3);
omega4 = omega.(4); omega5 = omega.(5); omega6 = omega.(6);
f1 = f.(1); f2 = f.(2); f3 = f.(3);
f4 = f.(4); f5 = f.(5); f6 = f.(6);
T1 = T.(1); T2 = T.(2); T3 = T.(3);
T4 = T.(4); T5 = T.(5); T6 = T.(6);

---
## 8. Resultados

> Frecuencias (rad/s):
@{cells} |w_1 = omega1 & rad/s|w_2 = omega2 & rad/s|w_3 = omega3 & rad/s|
@{cells} |w_4 = omega4 & rad/s|w_5 = omega5 & rad/s|w_6 = omega6 & rad/s|

> Frecuencias (Hz):
@{cells} |f_1 = f1 & Hz|f_2 = f2 & Hz|f_3 = f3 & Hz|
@{cells} |f_4 = f4 & Hz|f_5 = f5 & Hz|f_6 = f6 & Hz|

> Periodos (s):
@{cells} |T_1 = T1 & s|T_2 = T2 & s|T_3 = T3 & s|
@{cells} |T_4 = T4 & s|T_5 = T5 & s|T_6 = T6 & s|

---
## 9. Respuesta Dinamica (Parte c)

> Carga: F = 5000 lb en z (nodo 1), aplicada durante 0.1 s
> Integracion Newmark-beta (gamma=0.5, beta=0.25)
> dt = 0.0001 s, duracion total = 5 s (50001 pasos)

u_hist = newmark(Kf, Mf, Ff, 5, 0.0001, 0.1)

> Desplazamientos maximos del nodo 1 (6 DOFs):
@{columns 3}
u1_max = rowmax(u_hist, 1)
> dx max (in)
u2_max = rowmax(u_hist, 2)
> dy max (in)
u3_max = rowmax(u_hist, 3)
> dz max (in)
u4_max = rowmax(u_hist, 4)
> rx max (rad)
u5_max = rowmax(u_hist, 5)
> ry max (rad)
u6_max = rowmax(u_hist, 6)
> rz max (rad)
@{end columns}

> Referencia MATLAB (Paz & Leigh, Fig 13.4):
> u1_max = 8.814e-5 in, u2_max = 2.6552e-7 in, u3_max = 0.9827 rad

