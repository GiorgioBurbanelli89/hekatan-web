@{config bg:book, align:left, header:on, color:black}
---
# Space Frame Modal Analysis (MATLAB → MathCanvas)
---

@{text}
Replica del script MATLAB de Paz & Leigh "Structural Dynamics" - Example 6.3.
Ensamblaje con funciones SpaceFrameElement y SpaceFrameConsMass,
eigenvalores generalizados eig(Kf, Mf). Awatif solo para visualizacion 3D.
@{end text}

---
## 1. Funciones del Elemento

> SpaceFrameElement(E, G, Iz, Iy, J, A, coord)
> Generates equations for a space frame element
> E = modulus of elasticity (psi)
> G = Modulus of rigidity (psi)
> Iz, Iy = moment of inertias about element z and y axes (in^4)
> J = torsional rigity (in^4)
> A = area of cross-section (in^2)
> coord = coordinates at the element ends (3x3: n1, n2, n3)

function ke = SpaceFrameElement(E_p, G_p, Iz_p, Iy_p, J_p, A_p, coord)
  EIz = E_p*Iz_p; EIy = E_p*Iy_p; GJ = G_p*J_p; EA = E_p*A_p
  n1 = coord[1, 1:3]; n2 = coord[2, 1:3]; n3 = coord[3, 1:3]
  L = sqrt(dot(n2 - n1, n2 - n1))
  ex = (n2 - n1)/L
  eyy_v = cross(n3 - n1, n2 - n1)
  ey = eyy_v/sqrt(dot(eyy_v, eyy_v)); ez = cross(ex, ey)
  H = [ex[1],ex[2],ex[3]; ey[1],ey[2],ey[3]; ez[1],ez[2],ez[3]]
  T_e = zeros(12,12)
  for bi = 0:3
    for ii = 1:3
      for jj = 1:3
        T_e[bi*3+ii, bi*3+jj] = H[ii,jj]
      end
    end
  end
  TT = transpose(T_e)
  // ke local 12x12
  ke_loc = [EA/L, 0, 0, 0, 0, 0, -(EA/L), 0, 0, 0, 0, 0;
    0, (12*EIz)/L^3, 0, 0, 0, (6*EIz)/L^2, 0, -((12*EIz)/L^3), ...
    0, 0, 0, (6*EIz)/L^2;
    0, 0, (12*EIy)/L^3, 0, -((6*EIy)/L^2), 0, ...
    0, 0, -((12*EIy)/L^3), 0, -((6*EIy)/L^2), 0;
    0, 0, 0, GJ/L, 0, 0, 0, 0, 0, -(GJ/L), 0, 0;
    0, 0, -((6*EIy)/L^2), 0, (4*EIy)/L, 0, 0, 0, (6*EIy)/L^2, ...
    0, (2*EIy)/L, 0;
    0, (6*EIz)/L^2, 0, 0, 0, (4*EIz)/L, 0, ...
    -((6*EIz)/L^2), 0, 0, 0, (2*EIz)/L;
    -(EA/L), 0, 0, 0, 0, 0, EA/L, 0, 0, 0, 0, 0;
    0, -((12*EIz)/L^3), 0, 0, 0, -((6*EIz)/L^2), ...
    0, (12*EIz)/L^3, 0, 0, 0, -((6*EIz)/L^2);
    0, 0, -((12*EIy)/L^3), 0, (6*EIy)/L^2, 0, 0, 0, ...
    (12*EIy)/L^3, 0, (6*EIy)/L^2, 0;
    0, 0, 0, -(GJ/L), 0, 0, 0, 0, 0, GJ/L, 0, 0;
    0, 0, -((6*EIy)/L^2), 0, (2*EIy)/L, 0, 0, 0, (6*EIy)/L^2, ...
    0, (4*EIy)/L, 0;
    0, (6*EIz)/L^2, 0, 0, 0, (2*EIz)/L, 0, -((6*EIz)/L^2), 0, ...
    0, 0, (4*EIz)/L]
  ke = TT*ke_loc*T_e
end

> SpaceFrameConsMass: Genera M consistente 12x12 y transforma a global
> Parametros: m_bar (masa/long), I0 (Ip polar), A, nodos (2x3 + aux)

function me = SpaceFrameConsMass(m_bar_p, I0_p, A_p, coord)
  n1 = coord[1, 1:3]; n2 = coord[2, 1:3]; n3 = coord[3, 1:3]
  L = sqrt(dot(n2 - n1, n2 - n1))
  ex = (n2 - n1)/L
  eyy_v = cross(n3 - n1, n2 - n1)
  ey = eyy_v/sqrt(dot(eyy_v, eyy_v)); ez = cross(ex, ey)
  H = [ex[1],ex[2],ex[3]; ey[1],ey[2],ey[3]; ez[1],ez[2],ez[3]]
  T_e = zeros(12,12)
  for bi = 0:3
    for ii = 1:3
      for jj = 1:3
        T_e[bi*3+ii, bi*3+jj] = H[ii,jj]
      end
    end
  end
  rr = I0_p/A_p
  m_loc = m_bar_p*L/420*[140, 0, 0, 0, 0, 0, 70, 0, 0, 0, 0, 0;
    0, 156, 0, 0, 0, 22*L, 0, 54, 0, 0, 0, -13*L;
    0, 0, 156, 0, -22*L, 0, 0, 0, 54, 0, 13*L, 0;
    0, 0, 0, 140*rr, 0, 0, 0, 0, 0, 70*rr, 0, 0;
    0, 0, -22*L, 0, 4*L^2, 0, 0, 0, -13*L, 0, -3*L^2, 0;
    0, 22*L, 0, 0, 0, 4*L^2, 0, 13*L, 0, 0, 0, -3*L^2;
    70, 0, 0, 0, 0, 0, 140, 0, 0, 0, 0, 0;
    0, 54, 0, 0, 0, 13*L, 0, 156, 0, 0, 0, -22*L;
    0, 0, 54, 0, -13*L, 0, 0, 0, 156, 0, 22*L, 0;
    0, 0, 0, 70*rr, 0, 0, 0, 0, 0, 140*rr, 0, 0;
    0, 0, 13*L, 0, -3*L^2, 0, 0, 0, 22*L, 0, 4*L^2, 0;
    0, -13*L, 0, 0, 0, -3*L^2, 0, -22*L, 0, 0, 0, 4*L^2]
  TT = transpose(T_e)
  me = TT*m_loc*T_e
end

