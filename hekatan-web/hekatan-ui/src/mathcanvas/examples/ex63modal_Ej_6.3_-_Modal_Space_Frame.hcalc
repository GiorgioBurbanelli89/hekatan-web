## 1. Propiedades del Material
@{cells} |E_s = 29500 & ksi|nu = 0.3|G_s = E_s/(2*(1 + nu)) & ksi|

## 2. Secciones
> W24x146 (Columnas) - AISC 9th Ed.
@{cells} |A_c = 42.7 & in^2|I_c33 = 4580 & in^4|I_c22 = 391 & in^4|J_c = 12.6 & in^4|

> W14x82 (Vigas) - AISC 9th Ed.
@{cells} |A_g = 24.0 & in^2|I_g33 = 882 & in^4|I_g22 = 148 & in^4|J_g = 5.07 & in^4|

## 3. Geometria
@{cells} |L_c = 180 & in|L_gx = 240 & in|L_gy = 114 & in|

## 4. Masa Concentrada
> m = 0.001 kip*s^2/in por DOF traslacional en cada nodo libre (2, 4, 5, 7)
m = 0.001

---
## 5. Rigidez Local (n_e = 8 elementos, Eq 6.1)
> Propiedades por elemento (vectores)
> e=1..4: Columna W24x146 (L=180), e=5,6: Viga X W14x82 (L=240), e=7,8: Viga Y W14x82 (L=114)
> Vigas con alma vertical: Iz=I_22 (eje debil, flexion horizontal), Iy=I_33 (eje fuerte, flexion vertical)

n_e = 8
A_el = [[A_c],[A_c],[A_c],[A_c],[A_g],[A_g],[A_g],[A_g]]
Iz_el = [[I_c33],[I_c33],[I_c33],[I_c33],[I_g22],[I_g22],[I_g22],[I_g22]]
Iy_el = [[I_c22],[I_c22],[I_c22],[I_c22],[I_g33],[I_g33],[I_g33],[I_g33]]
J_el = [[J_c],[J_c],[J_c],[J_c],[J_g],[J_g],[J_g],[J_g]]
L_el = [[L_c],[L_c],[L_c],[L_c],[L_gx],[L_gx],[L_gy],[L_gy]]

> Rigidez local 12x12 para cada elemento
K_loc = cell(n_e)
for el = 1:n_e
Le = L_el[el,1]
ea = E_s*A_el[el,1]/Le
vz = 12*E_s*Iz_el[el,1]/Le^3
sz = 6*E_s*Iz_el[el,1]/Le^2
fz = 4*E_s*Iz_el[el,1]/Le
gz = 2*E_s*Iz_el[el,1]/Le
vy = 12*E_s*Iy_el[el,1]/Le^3
sy = 6*E_s*Iy_el[el,1]/Le^2
fy = 4*E_s*Iy_el[el,1]/Le
gy_k = 2*E_s*Iy_el[el,1]/Le
gj = G_s*J_el[el,1]/Le
k = [[ea,0,0,0,0,0,-ea,0,0,0,0,0],[0,vz,0,0,0,sz,0,-vz,0,0,0,sz],[0,0,vy,0,-sy,0,0,0,-vy,0,-sy,0],[0,0,0,gj,0,0,0,0,0,-gj,0,0],[0,0,-sy,0,fy,0,0,0,sy,0,gy_k,0],[0,sz,0,0,0,fz,0,-sz,0,0,0,gz],[-ea,0,0,0,0,0,ea,0,0,0,0,0],[0,-vz,0,0,0,-sz,0,vz,0,0,0,-sz],[0,0,-vy,0,sy,0,0,0,vy,0,sy,0],[0,0,0,-gj,0,0,0,0,0,gj,0,0],[0,0,-sy,0,gy_k,0,0,0,sy,0,fy,0],[0,sz,0,0,0,gz,0,-sz,0,0,0,fz]]
cset(K_loc, el, k)
end

> Columna (e=1): K_loc{1}
K_loc{1}
> Viga X (e=5): K_loc{5}
K_loc{5}
> Viga Y (e=7): K_loc{7}
K_loc{7}

