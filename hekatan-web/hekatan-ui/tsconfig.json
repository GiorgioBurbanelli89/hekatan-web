{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "hekatan-math/*": ["../hekatan-math/src/*"],
      "awatif-fem": ["../hekatan-math/src/awatif-fem"],
      "awatif-fem/*": ["../hekatan-math/src/awatif-fem/*"],
      "awatif-ui": ["./src/awatif-ui"],
      "awatif-ui/*": ["./src/awatif-ui/*"],
      "awatif-mesh": ["../hekatan-math/src/awatif-mesh"],
      "awatif-mesh/*": ["../hekatan-math/src/awatif-mesh/*"]
    }
  },
  "include": ["src/**/*.ts", "editor/**/*.ts", "../hekatan-math/src/**/*.ts"]
}
