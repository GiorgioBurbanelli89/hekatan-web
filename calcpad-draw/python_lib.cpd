"--- CAS simbolico real con SymPy (Pyodide) + render LaTeX con KaTeX. El usuario deja el resultado en R ---
#def cas_begin$(id$) = '<div id="id$" style="border:1px solid #ccc;padding:10px;min-height:36px">Cargando SymPy (CAS)...</div><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"/><script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script><script>(async function(){try{var py=await loadPyodide();await py.loadPackage("sympy");var src=String.raw`from sympy import *@@
#def cas_end$(id$) = '@@latex(R)`.split("@@").join(String.fromCharCode(10));var tex=await py.runPythonAsync(src);katex.render(tex,document.getElementById("id$"),{displayMode:true,throwOnError:false});}catch(e){document.getElementById("id$").innerText="Error CAS: "+e;}})();</script>
#show
