#include hekatan_lib.cpd
"=== Mesa a torsion — fuerzas internas de frames (estilo awatif frame results) ===
"
"Resuelve con deform.wasm y calcula N (axial), Vy/Vz (cortantes), T (torsion),
"My/Mz (momentos flectores) de cada COLUMNA y VIGA. Selector de diagrama 3D + tabla de valores.
"Parametros de hk_mesa: Lx; Ly; H; nMesh; E[Pa]; nu; tLosa; bCol; hCol; bViga; hViga; q[N/m2]
"
#val
hekatan_begin$(mesaf)
hk_mesa$(6; 6; 4; 5; 24.85e9; 0.20; 0.10; 0.40; 0.40; 0.30; 0.50; 6000)
hekatan_end3d_forces$(mesaf)
#equ
