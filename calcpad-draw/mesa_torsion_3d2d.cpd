#include hekatan_lib.cpd
"=== Mesa a torsion — interfaz grafica interactiva: 3D (WASM/awatif) arriba + 2D (Calcpad) abajo ===
"Pasa el cursor por las graficas para ver el valor del resultado en ese punto (3D y 2D).
#val
"--- (1) 3D interactivo: shells + frames, selector, hover, deformada (Three.js) ---
hekatan_begin$(m3d)
hk_mesa$(6; 6; 4; 5; 24.85e9; 0.20; 0.10; 0.40; 0.40; 0.30; 0.50; 6000)
hekatan_end3d_results$(m3d)
"--- (2) 2D interactivo: planta de la losa, contornos, colorbar, hover bilineal (canvas puro) ---
hekatan_begin$(m2d)
hk_mesa$(6; 6; 4; 5; 24.85e9; 0.20; 0.10; 0.40; 0.40; 0.30; 0.50; 6000)
hekatan_end2d$(m2d)
#equ
