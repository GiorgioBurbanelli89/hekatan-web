#def p5_end$(id$) = '},"id$");}init();})();</script>
"=== THREE.JS (three@0.160, modulo) ===
#def three_cdn$ = '<script type="importmap">{"imports":{"three":"https://unpkg.com/three@0.160.0/build/three.module.js","three/addons/":"https://unpkg.com/three@0.160.0/examples/jsm/"}}</script>
#def three_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;height:'h$'px;border:1px solid #ccc;background:#fafafa;margin:auto"></div><script type="module">import * as THREE from "three";import {OrbitControls} from "three/addons/controls/OrbitControls.js";(function(){var container=document.getElementById("id$");var width='w$';var height='h$';var scene=new THREE.Scene();scene.background=new THREE.Color(0xfafafa);var camera=new THREE.PerspectiveCamera(60,width/height,0.1,1000);camera.position.set(5,5,5);camera.lookAt(0,0,0);var renderer=new THREE.WebGLRenderer({antialias:true});renderer.setSize(width,height);container.appendChild(renderer.domElement);var controls=new OrbitControls(camera,renderer.domElement);scene.add(new THREE.AmbientLight(0xffffff,0.5));var dl=new THREE.DirectionalLight(0xffffff,0.8);dl.position.set(5,10,7);scene.add(dl);
#def three_end$ = 'function animate(){requestAnimationFrame(animate);controls.update();renderer.render(scene,camera);}animate();})();</script>
"=== JSXGRAPH (jsxgraph@1.10) ===
#def jsx_cdn$ = '<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsxgraph@1.10/distrib/jsxgraph.css"/><script src="https://cdn.jsdelivr.net/npm/jsxgraph@1.10/distrib/jsxgraphcore.min.js"></script>
#def jsx_begin$(id$; w$; h$) = '<div id="id$" class="jxgbox" style="width:'w$'px;height:'h$'px;margin:auto"></div><script>(function(){function init(){if(typeof JXG==="undefined"){setTimeout(init,200);return;}var board=JXG.JSXGraph.initBoard("id$",{boundingbox:[-5,5,5,-5],axis:true,showCopyright:false,showNavigation:true});
#def jsx_end$ = '}init();})();</script>
"=== LEAFLET MAPS (leaflet@1.9.4) ===
#def map_cdn$ = '<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
#def map_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;height:'h$'px;margin:auto"></div><script>(function(){function init(){if(typeof L==="undefined"){setTimeout(init,200);return;}var map=L.map("id$").setView([0,0],2);L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{attribution:"OpenStreetMap"}).addTo(map);
#def map_end$ = '}init();})();</script>
