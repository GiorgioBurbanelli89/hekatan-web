#hide
"Calcpad PURE web-deps library — replica las directivas web de Calcpad-Symbolic como def inline
"Patron (envolver en val ... equ): NAME_cdn  /  NAME_begin(id; w; h)  /  cuerpo crudo con apostrofo  /  NAME_end(id)
"id = token unico por grafico. El cuerpo (spec JSON, JS o DSL) se escribe como lineas de texto crudas.
"NOTA: el CLI solo emite el HTML; el render real (JS) se ve en el editor web o un browser.
"=== PLOTLY (plotly-2.26.0) ===
#def plotly_cdn$ = '<script src="https://cdn.plot.ly/plotly-2.26.0.min.js" charset="utf-8"></script>
#def plotly_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;height:'h$'px;margin:auto"></div><script>(function(){function init(){if(typeof Plotly==="undefined"){setTimeout(init,200);return;}var spec=
#def plotly_end$(id$) = ';var data=spec.data||[];var layout=spec.layout||{};Plotly.newPlot("id$",data,layout,{responsive:true});}init();})();</script>
"=== CHART.JS (chart.js@4.4.0) ===
#def chart_cdn$ = '<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0"></script>
#def chart_begin$(id$; w$; h$) = '<div style="width:'w$'px;height:'h$'px;margin:auto"><canvas id="id$"></canvas></div><script>(function(){function init(){if(typeof Chart==="undefined"){setTimeout(init,200);return;}var config=
#def chart_end$(id$) = ';new Chart(document.getElementById("id$"),config);}init();})();</script>
"=== ECHARTS (echarts@5.4.3) ===
#def echarts_cdn$ = '<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
#def echarts_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;height:'h$'px;margin:auto"></div><script>(function(){function init(){if(typeof echarts==="undefined"){setTimeout(init,200);return;}var chart=echarts.init(document.getElementById("id$"));var option=
#def echarts_end$ = ';chart.setOption(option);}init();})();</script>
"=== VEGA-LITE (vega + vega-lite + vega-embed) ===
#def vega_cdn$ = '<script src="https://cdn.jsdelivr.net/npm/vega@5.25.0"></script><script src="https://cdn.jsdelivr.net/npm/vega-lite@5.21.0"></script><script src="https://cdn.jsdelivr.net/npm/vega-embed@6.22.0"></script>
#def vega_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;margin:auto"></div><script>(function(){function init(){if(typeof vegaEmbed==="undefined"){setTimeout(init,200);return;}var spec=
#def vega_end$(id$) = ';vegaEmbed("#id$",spec,{actions:false});}init();})();</script>
"=== KATEX (katex@0.16.9) ===
#def math_cdn$ = '<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"/><script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
#def math_begin$(id$; w$; h$) = '<div id="id$" style="text-align:center;margin:1em auto;max-width:'w$'px;font-size:1.1em"></div><script>(function(){function init(){if(typeof katex==="undefined"){setTimeout(init,200);return;}katex.render(String.raw`
#def math_end$(id$) = '`,document.getElementById("id$"),{throwOnError:false,displayMode:true});}init();})();</script>
