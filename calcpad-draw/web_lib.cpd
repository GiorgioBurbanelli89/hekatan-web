#def anime_end$ = '}init();})();</script>
"=== MATHBOX (mathbox@2.3.1) ===
#def mathbox_cdn$ = '<script src="https://unpkg.com/mathbox@2.3.1/build/bundle/mathbox.js"></script><link rel="stylesheet" href="https://unpkg.com/mathbox@2.3.1/build/mathbox.css"/>
#def mathbox_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;height:'h$'px;margin:auto;background:#000"></div><script>(function(){function init(){if(typeof mathBox==="undefined"){setTimeout(init,200);return;}var el=document.getElementById("id$");var mathbox=mathBox({plugins:["core","controls","cursor","mathbox"],controls:{klass:THREE.OrbitControls},element:el});if(mathbox.three)mathbox.three.renderer.setClearColor(new THREE.Color(0x000000),1.0);
#def mathbox_end$ = '}init();})();</script>
"=== CANNON-ES (three@0.160 + cannon-es@0.20.0, fisica 3D) ===
#def cannon_cdn$ = '<script type="importmap">{"imports":{"three":"https://unpkg.com/three@0.160.0/build/three.module.js","three/addons/":"https://unpkg.com/three@0.160.0/examples/jsm/","cannon-es":"https://unpkg.com/cannon-es@0.20.0/dist/cannon-es.js"}}</script>
#def cannon_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;height:'h$'px;margin:auto;background:#fafafa"></div><script type="module">import * as THREE from "three";import {OrbitControls} from "three/addons/controls/OrbitControls.js";import * as CANNON from "cannon-es";(function(){var container=document.getElementById("id$");var width='w$';var height='h$';var scene=new THREE.Scene();scene.background=new THREE.Color(0xfafafa);var camera=new THREE.PerspectiveCamera(60,width/height,0.1,1000);camera.position.set(8,8,8);camera.lookAt(0,0,0);var renderer=new THREE.WebGLRenderer({antialias:true});renderer.setSize(width,height);container.appendChild(renderer.domElement);var controls=new OrbitControls(camera,renderer.domElement);scene.add(new THREE.AmbientLight(0xffffff,0.5));var dl=new THREE.DirectionalLight(0xffffff,0.8);dl.position.set(5,10,7);scene.add(dl);var world=new CANNON.World({gravity:new CANNON.Vec3(0,-9.82,0)});
#def cannon_end$ = 'function animate(){requestAnimationFrame(animate);world.fixedStep();controls.update();renderer.render(scene,camera);}animate();})();</script>
"=== MANIM-STYLE (mathbox@2.3.1, fondo oscuro 3blue1brown) ===
#def manim_cdn$ = '<script src="https://unpkg.com/mathbox@2.3.1/build/bundle/mathbox.js"></script><link rel="stylesheet" href="https://unpkg.com/mathbox@2.3.1/build/mathbox.css"/>
#def manim_begin$(id$; w$; h$) = '<div id="id$" style="width:'w$'px;height:'h$'px;margin:auto;background:#000"></div><script>(function(){function init(){if(typeof mathBox==="undefined"){setTimeout(init,200);return;}var el=document.getElementById("id$");var mathbox=mathBox({plugins:["core","controls","cursor","mathbox"],controls:{klass:THREE.OrbitControls},element:el});if(mathbox.three)mathbox.three.renderer.setClearColor(new THREE.Color(0x000000),1.0);var palette={blue:"#1f77b4",orange:"#ff7f0e",green:"#2ca02c",red:"#d62728",purple:"#9467bd"};
#def manim_end$ = '}init();})();</script>
